{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QRMI Payload",
  "description": "The input to QPU resource",
  "version": "0.4.0",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "description": "Payload for `ibm-quantum-system` and `ibm-quantum-compute-service` (replaces `qiskit-runtime-service`) QPU resource",
      "required": [
        "program_id",
        "parameters"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "enum": [
            "estimator",
            "sampler"
          ],
          "description": "ID of the primitive to be executed."
        },
        "parameters": {
          "type": "object",
          "description": "Parameters to inject into the primitive. Estimator schema: https://github.com/Qiskit/ibm-quantum-schemas/blob/main/schemas/estimator_v2_schema.json, Sampler schema: https://github.com/Qiskit/ibm-quantum-schemas/blob/main/schemas/sampler_v2_schema.json"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "schema_version"
            ]
          },
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "job_type"
            ],
            "properties": {
              "job_type": {
                "type": "string",
                "pattern": "^([rR][eE][qQ][uU][eE][sS][tT]|[eE][xX][eE][cC][uU][tT][eE]|[eE][sS][tT][iI][mM][aA][tT][eE])$"
              }
            }
          }
        ]
      }
    },
    {
      "type": "object",
      "description": "Payload for `pasqal-cloud` QPU resource",
      "required": [
        "job_runs",
        "sequence"
      ],
      "properties": {
        "job_runs": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of times the pulser sequence is repeated."
        },
        "sequence": {
          "type": "object",
          "description": "Pulser sequence. Refer https://pulser.readthedocs.io/en/stable/tutorials/serialization.html for creation."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "schema_version"
            ]
          },
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "job_type"
            ],
            "properties": {
              "job_type": {
                "type": "string",
                "pattern": "^([rR][eE][qQ][uU][eE][sS][tT]|[eE][xX][eE][cC][uU][tT][eE]|[eE][sS][tT][iI][mM][aA][tT][eE])$"
              }
            }
          }
        ]
      }
    },
    {
      "type": "object",
      "description": "Payload for `alice-bob-felis`",
      "required": [
        "human_qir",
        "input_params"
      ],
      "properties": {
        "human_qir": {
          "type": "string",
          "description": "Human-readable QIR code."
        },
        "input_params": {
          "type": "object",
          "description": "Input parameters for the Felis Job. These vary depending on the quantum resource."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "schema_version"
            ]
          },
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "job_type"
            ],
            "properties": {
              "job_type": {
                "type": "string",
                "pattern": "^([rR][eE][qQ][uU][eE][sS][tT]|[eE][xX][eE][cC][uU][tT][eE]|[eE][sS][tT][iI][mM][aA][tT][eE])$"
              }
            }
          }
        ]
      }
    },
    {
      "type": "object",
      "description": "Payload for `iqm-server` QPU resource",
      "required": [
        "iqmjson",
        "job_type"
      ],
      "properties": {
        "iqmjson": {
          "type": "string",
          "description": "IQM JSON string."
        },
        "job_type": {
          "type": "string",
          "enum": [
            "circuit",
            "run",
            "sweep"
          ],
          "description": "Job type."
        },
        "use_timeslot": {
          "type": "boolean",
          "default": false,
          "description": "Set use_timeslot=true to submit the job to the timeslot queue instead of the default FIFO queue."
        },
        "tag": {
          "type": "string",
          "description": "Optional user-defined tag associated with the job. Can be used for external identification or filtering jobs. Max length is 50 characters."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "schema_version"
            ]
          },
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "job_type"
            ],
            "properties": {
              "job_type": {
                "type": "string",
                "pattern": "^([rR][eE][qQ][uU][eE][sS][tT]|[eE][xX][eE][cC][uU][tT][eE]|[eE][sS][tT][iI][mM][aA][tT][eE])$"
              }
            }
          }
        ]
      }
    },
    {
      "type": "object",
      "description": "Payload for `maestro-local`",
      "required": [
        "input",
        "job_type",
        "qubits",
        "simulator_type",
        "simulation_method"
      ],
      "properties": {
        "input": {
          "type": "string",
          "description": "QASM source for legacy execute/estimate jobs."
        },
        "job_type": {
          "type": "string",
          "description": "Job type.",
          "pattern": "^([eE][xX][eE][cC][uU][tT][eE]|[eE][sS][tT][iI][mM][aA][tT][eE])$"
        },
        "qubits": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive qubit count for legacy jobs.",
          "maximum": 4294967295
        },
        "simulator_type": {
          "type": "integer",
          "minimum": 0,
          "description": "Simulator type.",
          "maximum": 4294967295
        },
        "simulation_method": {
          "type": "integer",
          "minimum": 0,
          "description": "Simulation method.",
          "maximum": 4294967295
        },
        "observables": {
          "type": "string",
          "description": "Observables."
        },
        "config": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "description": "Optional configuration parameters for the job, in a json format."
        }
      },
      "additionalProperties": false
    },
    {
      "$ref": "#/$defs/maestroRequest"
    },
    {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "oneOf": [
            {
              "$ref": "#/$defs/maestroRequest"
            },
            {
              "type": "string",
              "description": "Serialized native schema-2 JSON; contents validated by the runner and Maestro."
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Wrapped native Maestro runner request."
    },
    {
      "type": "object",
      "description": "Native Maestro request through the legacy payload envelope. Legacy configuration fields are optional and ignored.",
      "required": [
        "job_type",
        "input"
      ],
      "properties": {
        "job_type": {
          "type": "string",
          "pattern": "^[rR][eE][qQ][uU][eE][sS][tT]$"
        },
        "input": {
          "oneOf": [
            {
              "$ref": "#/$defs/maestroRequest"
            },
            {
              "type": "string",
              "description": "Serialized native schema-2 JSON; contents validated by the runner and Maestro."
            }
          ]
        },
        "qubits": {},
        "simulator_type": {},
        "simulation_method": {},
        "observables": {},
        "config": {}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Payload for `oqtopus` QPU resource",
      "required": [
        "job_spec"
      ],
      "properties": {
        "job_spec": {
          "type": "string",
          "description": "Job spec, as a JSON object string matching the keyword arguments of Python's `OqtopusJobSpec` dataclass, minus `device_id` (QRMI fills that in automatically). Required keys: `job_type` (one of \"sampling\", \"estimation\", \"multi_manual\", \"sse\") and `program` (array of strings; a single program is a single-element array; `sse` jobs require exactly one). Optional keys: `shots` (integer; omit the key entirely to use OQTOPUS's default of 1000 \u2014 sending `null` fails), `name`, `description`, `transpiler_info`, `simulator_info`, `mitigation_info`, and `operator` (for estimation jobs)."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "schema_version"
            ]
          },
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "job_type"
            ],
            "properties": {
              "job_type": {
                "type": "string",
                "pattern": "^([rR][eE][qQ][uU][eE][sS][tT]|[eE][xX][eE][cC][uU][tT][eE]|[eE][sS][tT][iI][mM][aA][tT][eE])$"
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "maestroRequest": {
      "type": "object",
      "required": [
        "schema_version",
        "operation"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "operation": {
          "type": "string"
        }
      },
      "description": "Native Maestro request for either task runner; detailed validation occurs in Maestro.",
      "not": {
        "anyOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "job_type"
            ]
          },
          {
            "required": [
              "qubits"
            ]
          },
          {
            "required": [
              "simulator_type"
            ]
          },
          {
            "required": [
              "simulation_method"
            ]
          },
          {
            "required": [
              "config"
            ]
          },
          {
            "required": [
              "request"
            ]
          },
          {
            "required": [
              "program_id"
            ]
          },
          {
            "required": [
              "parameters"
            ]
          },
          {
            "required": [
              "job_runs"
            ]
          },
          {
            "required": [
              "sequence"
            ]
          },
          {
            "required": [
              "human_qir"
            ]
          },
          {
            "required": [
              "input_params"
            ]
          },
          {
            "required": [
              "iqmjson"
            ]
          },
          {
            "required": [
              "use_timeslot"
            ]
          },
          {
            "required": [
              "tag"
            ]
          },
          {
            "required": [
              "job_spec"
            ]
          }
        ]
      }
    }
  }
}
